{
  "manifest_version": 3,
  "name": "飞书剪存pro",
  "version": "1.1.5",
  "description": "一键将当前网页完整保存为飞书云文档和多维表格，支持格式保真、AI整理与跨设备查重。",
  "homepage_url": "https://github.com/lproc2006/feishu-clipper-pro",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "飞书剪存pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
